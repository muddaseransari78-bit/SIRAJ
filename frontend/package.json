{
  "name": "siraj-frontend",
  "version": "1.0.0",
  "description": "SIRAJ - Illuminate Your Heart With Knowledge - Frontend",
  "type": "module",
  "scripts": {
    "theme:css": "node scripts/gen-theme-css.mjs",
    "predev": "npm run theme:css",
