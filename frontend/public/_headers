# Security + caching headers for Netlify (Phase 20). Vercel uses vercel.json instead.
# Change them in BOTH files if you edit one (a test checks that they match).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Built files have a hash in their name, so they can be cached for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Phase 36: theme pictures, logo and hero video never change under the same name: cache for 30 days
/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# The service worker must always be re-checked so updates arrive
/sw.js
  Cache-Control: no-cache
