# URL of the SIRAJ backend API (used when the site is built).
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
# Production example (your deployed backend):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Google / Apple sign-in buttons (optional). Use the SAME ids as GOOGLE_CLIENT_ID / APPLE_CLIENT_ID in backend/.env.
# A button is shown only when the backend has its id set. See DEPLOYMENT.md -> "Google and Apple sign-in".
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# Apple needs the exact return address you registered for the Services ID (normally your site address).
# VITE_APPLE_REDIRECT_URI=https://your-site.vercel.app
