# SIRAJ Backend Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to git.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/siraj

# JWT secrets - use long random strings in production (at least 32 characters, and the two must be different).
# Make one with this command (PowerShell) and paste the result:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
# 90 days, and renewed every visit: a person who opened SIRAJ once stays logged in when they come back.
JWT_REFRESH_EXPIRES_IN=90d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google / Apple sign-in (optional). A button appears on Login / Register only when its id is set.
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application).
#   Put your site address under "Authorised JavaScript origins". Use the SAME id as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# Apple: developer.apple.com -> Identifiers -> Services ID (the "Sign in with Apple" web id, e.g. com.yourname.siraj.web).
#   Use the SAME id as VITE_APPLE_CLIENT_ID in the frontend.
APPLE_CLIENT_ID=

# External Quran API (AlQuran Cloud - no key required, but kept here
# in case you switch providers later)
QURAN_API_BASE_URL=https://api.alquran.cloud/v1

# External Prayer Times API (AlAdhan)
PRAYER_API_BASE_URL=https://api.aladhan.com/v1

# Unified Islamic data API (Hadith, Duas, Qibla) - free, no key required
ISLAMIC_API_BASE_URL=https://api.islamic.app

# "lax" (default): the site and the API share one address (local development, or Vercel passing /api to this backend - the recommended setup, it keeps iPhone/Safari logged in).
# "none" ONLY when the frontend calls this backend directly on a different domain (needs HTTPS; Safari may block that cookie).
COOKIE_SAMESITE=lax

# Trust the reverse proxy on hosts like Render/Railway so rate limiting sees real IPs (1 on Render alone).
# Render behind a Vercel /api rewrite = two proxies: set 2.
TRUST_PROXY=0

# Optional: zabar / zer / pesh check for Live Recitation (see ../pronunciation-service/README.md).
# Leave PRONUNCIATION_API_URL empty to switch the feature off (the page then says it is not set up).
PRONUNCIATION_API_URL=
PRONUNCIATION_API_KEY=
PRONUNCIATION_TIMEOUT_MS=60000

# Optional (Phase 20): general rate limits. Defaults are fine for normal use.
# RATE_LIMIT_API_MAX=300      requests per minute per visitor for the whole /api
# RATE_LIMIT_REFRESH_MAX=60   session refreshes per 15 minutes per visitor

# Optional: place-name search for Qibla / Prayer (default is the free Open-Meteo geocoder, no key needed).
# GEOCODE_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Used only by "npm run seed" (creates the first SUPER_ADMIN). Set a STRONG password of your own.
# In production the seed script refuses to run without SEED_ADMIN_PASSWORD.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=choose_a_strong_password_here

# Phase 31 - prayer / Jamaat reminders that arrive even when the browser is closed (Web Push). Optional.
# Make the keys ONCE with:  npm run vapid   (then paste the lines here). Without them only in-page reminders work.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Optional: secret for an external timer (cron-job.org) that calls /api/cron/prayer-tick - keeps a free host awake.
# CRON_SECRET=
# PUSH_SCHEDULER=off          switch the 30-second timer off (default: on when the VAPID keys are set)
# PUSH_GRACE_MINUTES=4        a reminder up to this many minutes late is still sent (sleeping host)

# Optional: Urdu translation of Duas (default is the free MyMemory service).
# URDU_TRANSLATE_URL=https://api.mymemory.translated.net
# MYMEMORY_EMAIL=you@example.com
# Optional: Urdu Hadith source (default is built in).
# URDU_HADITH_BASE_URL=
