# Copy to .env.docker (never commit it). Make the two secrets with:  cd backend ; npm run secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# For the first admin (docker compose exec backend node scripts/seed.js). Choose a strong password.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=
# Optional (Phase 31): prayer reminders when the browser is closed. Make the keys with:  cd backend ; npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional (Phase 38): Google / Apple sign-in. Same ids are used by the backend and the page. Empty = no button.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
